// Upclose — modèle de données du MVP.
// Voir docs/ARCHITECTURE.md pour les règles métier (capacité, visibilité, blocage).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MomentStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

/// public      : visible dans le feed, place confirmée immédiatement (accès instantané choisi par l'hôte)
/// request     : visible dans le feed, l'hôte accepte ou refuse chaque demande
/// invite_only : absent du feed, visible par l'hôte et les personnes invitées
/// private     : absent du feed, visible par lien direct, l'hôte accepte ou refuse
enum MomentVisibility {
  PUBLIC
  REQUEST
  INVITE_ONLY
  PRIVATE
}

enum MediaType {
  IMAGE
  VIDEO
  TEXT
}

enum MembershipKind {
  REQUEST // l'utilisateur demande à rejoindre
  INVITE // l'hôte invite l'utilisateur
}

enum MembershipStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum NotificationType {
  JOIN_REQUEST
  REQUEST_ACCEPTED
  REQUEST_DECLINED
  INVITATION
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  MEMBER_LEFT
  MOMENT_CANCELLED
  MOMENT_UPDATED
  NEW_MESSAGE
  REMINDER
  RATE_MOMENT
  NEW_SOUVENIR
  PHOTO_VERIFIED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id                   String        @id @default(cuid())
  /// Peut être vide pour un compte créé avec un numéro de téléphone.
  email                String?       @unique
  passwordHash         String?
  /// Identifiant Google (claim « sub ») si le compte utilise la connexion Google.
  googleId             String?       @unique
  /// Identifiant Facebook (propre à l'app Upclose) si le compte utilise la connexion Facebook.
  facebookId           String?       @unique
  /// Numéro de téléphone au format international (+33612345678), confirmé par un code SMS.
  phone                String?       @unique
  phoneVerifiedAt      DateTime?
  /// Date de confirmation de l'adresse e-mail (lien reçu par e-mail, ou e-mail vérifié par Google).
  emailVerifiedAt      DateTime?
  name                 String
  username             String        @unique
  bio                  String        @default("")
  photoUrl             String?
  city                 String        @default("")
  interests            String[]      @default([])
  role                 UserRole      @default(USER)
  status               AccountStatus @default(ACTIVE)
  /// Compte de démonstration : fictif, jamais présenté comme réel.
  isDemo               Boolean       @default(false)
  /// L'utilisateur choisit si ses Moments vécus apparaissent sur son profil public.
  showPastMoments      Boolean       @default(true)
  /// Lecture automatique (muette) des vidéos du feed.
  autoplayVideos       Boolean       @default(true)
  /// Majorité confirmée par la personne (case à cocher « j'ai 18 ans ou plus »), requise pour l'espace adulte.
  adultConfirmedAt     DateTime?
  /// Opt-in volontaire : voir et créer des Moments de l'espace adulte. Désactivé par défaut.
  showAdult            Boolean       @default(false)
  /// Compte Instagram déclaré par la personne (sans @), affiché sur son profil comme repère de confiance.
  /// Déclaratif : signalé « non vérifié » tant qu'aucune connexion Instagram ne le confirme.
  instagram            String?
  /// Quelques photos choisies par la personne pour son profil (6 maximum), envoyées depuis Upclose.
  gallery              String[]      @default([])
  /// Upclose+ actif jusqu'à cette date (abonnement Stripe ou paiement de test). null : offre gratuite.
  premiumUntil         DateTime?
  /// « stripe » ou « test » (paiement simulé, aucun débit).
  premiumSource        String?
  premiumCancelAt      DateTime?
  /// Offre payante : « plus » ou « black » (null = plus pour les anciens abonnements).
  premiumPlan          String?
  /// « month » ou « year ».
  premiumInterval      String?
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  /// Photo de profil certifiée (selfie pris en direct avec la caméra, comparé à la photo). null : non certifiée.
  photoVerifiedAt      DateTime?
  /// Date de naissance déclarée lors de la vérification du profil (18 ans minimum).
  birthDate            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sessions       Session[]
  hostedMoments  Moment[]           @relation("MomentHost")
  memberships    MomentMembership[] @relation("MembershipUser")
  initiated      MomentMembership[] @relation("MembershipInitiator")
  notifications  Notification[]
  reportsFiled   Report[]           @relation("ReportReporter")
  blocksMade     Block[]            @relation("Blocker")
  blocksGot      Block[]            @relation("Blocked")
  authTokens     AuthToken[]
  uploads        Upload[]
  availabilities Availability[]
  messages       MomentMessage[]
  souvenirs      Souvenir[]
  ratingsGiven   Rating[]           @relation("RatingRater")
  ratingsGot     Rating[]           @relation("RatingRatee")
  viewsMade      ProfileView[]      @relation("ViewViewer")
  viewsGot       ProfileView[]      @relation("ViewOwner")
  verifications  PhotoVerification[]
}

/// Demande de certification : selfie pris en direct (caméra, pas la galerie) avec un geste demandé au hasard.
model PhotoVerification {
  id         String   @id @default(cuid())
  userId     String
  /// Selfie privé, jamais affiché ailleurs que dans l'espace de modération.
  selfieUrl  String
  /// Le geste demandé (ex. « pouce levé »), pour prouver que la photo est prise à l'instant.
  gesture    String
  /// La photo de profil au moment de la demande (comparée au selfie).
  photoUrl   String
  /// PENDING, APPROVED ou REJECTED.
  status     String   @default("PENDING")
  /// « auto » (vérification automatique) ou id de la personne de l'équipe qui a validé.
  reviewedBy String?
  reason     String   @default("")
  createdAt  DateTime @default(now())
  reviewedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

/// Visite d'un profil ou d'un Moment (une par personne, cible et jour). Visible par le propriétaire avec Upclose Black.
model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  ownerId   String
  /// « profile » ou l'id du Moment consulté.
  target    String
  day       String
  createdAt DateTime @default(now())
  viewer    User     @relation("ViewViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  owner     User     @relation("ViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([viewerId, ownerId, target, day])
  @@index([ownerId, createdAt])
}

model Session {
  id        String   @id // sha256 du jeton ; le jeton brut ne vit que dans le cookie
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Moment {
  id                 String           @id @default(cuid())
  hostId             String
  title              String
  description        String
  category           String
  vibeTags           String[]         @default([])
  mediaType          MediaType        @default(IMAGE)
  mediaUrl           String?
  posterUrl          String?
  /// Couleur/dégradé de la carte texte (clé de thème).
  textTheme          String?
  city               String
  /// Zone large visible par tous (quartier, plage…).
  area               String           @default("")
  /// Nom du lieu, visible par tous (peut être générique : « Rooftop à Golden Mile »).
  placeName          String           @default("")
  /// Adresse exacte : visible par l'hôte et les participants acceptés si addressMembersOnly.
  address            String?
  addressMembersOnly Boolean          @default(true)
  startsAt           DateTime
  endsAt             DateTime?
  timezone           String           @default("Europe/Madrid")
  /// Places pour les invités (hôte non compris).
  capacity           Int
  status             MomentStatus     @default(DRAFT)
  visibility         MomentVisibility @default(REQUEST)
  showAttendees      Boolean          @default(true)
  /// Espace adulte (18+) : jamais montré aux personnes qui ne l'ont pas activé.
  isAdult            Boolean          @default(false)
  /// Boost Upclose+ : le Moment passe en tête du feed de sa ville jusqu'à cette date.
  boostedUntil       DateTime?
  /// Position approximative (lieu ou quartier), jamais envoyée telle quelle au navigateur : sert au filtre de distance.
  lat                Float?
  lng                Float?
  /// Moment sélectif : seuls les membres Upclose Black peuvent le rejoindre.
  blackOnly          Boolean          @default(false)
  isDemo             Boolean          @default(false)
  cancelReason       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  publishedAt        DateTime?
  cancelledAt        DateTime?

  host        User               @relation("MomentHost", fields: [hostId], references: [id], onDelete: Cascade)
  memberships MomentMembership[]
  reports     Report[]
  messages    MomentMessage[]
  souvenirs   Souvenir[]
  ratings     Rating[]

  @@index([status, visibility, startsAt])
  @@index([city, startsAt])
  @@index([category, startsAt])
  @@index([hostId, startsAt])
}

model MomentMembership {
  id           String           @id @default(cuid())
  momentId     String
  userId       String
  initiatorId  String
  kind         MembershipKind
  status       MembershipStatus @default(PENDING)
  message      String?
  /// Dispo à l'origine de l'invitation (copie figée : texte, lieu, horaire), pour rappeler pourquoi on s'est contacté.
  dispoContext Json?
  /// Le participant accepte d'apparaître dans la liste visible des participants.
  showOnMoment Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  respondedAt  DateTime?

  moment    Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User   @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  initiator User   @relation("MembershipInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)

  /// Une seule ligne par personne et par Moment : pas de doublon de demande/invitation.
  @@unique([momentId, userId])
  @@index([momentId, status])
  @@index([userId, status])
  @@index([initiatorId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  momentId  String?
  actorId   String?
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetUserId String?
  momentId     String?
  reason       String
  details      String       @default("")
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolution   String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  reporter User    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moment   Moment? @relation(fields: [momentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// Journal des actions d'administration (suspension, retrait de contenu).
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

enum AuthTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Jeton à usage unique envoyé par e-mail. Seul son hachage sha256 est stocké.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

/// Fichier envoyé par un utilisateur : sert aux quotas et au nettoyage des fichiers.
model Upload {
  id        String   @id @default(cuid())
  userId    String
  url       String
  purpose   String
  bytes     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Disponibilité publiée volontairement (« je suis libre samedi soir »). Elle donne envie à quelqu'un
/// de créer un Moment et d'y inviter la personne ; elle n'envoie jamais d'invitation automatique et
/// ne fait pas de la personne un hôte. Elle expire seule à la fin du créneau.
model Availability {
  id         String   @id @default(cuid())
  userId     String
  startsAt   DateTime
  endsAt     DateTime
  timezone   String   @default("Europe/Madrid")
  city       String
  /// Zone large uniquement (quartier) : jamais d'adresse.
  area       String   @default("")
  /// Position approximative du quartier (filtre de distance).
  lat        Float?
  lng        Float?
  /// Envies (identifiants de catégories de Moment).
  categories String[] @default([])
  note       String   @default("")
  /// Masquée par son auteur : plus visible des autres, mais conservée.
  hidden     Boolean  @default(false)
  /// Dispo de l'espace adulte (18+) : visible uniquement par les personnes qui l'ont activé.
  isAdult    Boolean  @default(false)
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, endsAt])
  @@index([endsAt])
  @@index([userId, endsAt])
}

/// Message de la discussion d'un Moment : lisible et écrit par l'hôte et les participants acceptés.
model MomentMessage {
  id        String    @id @default(cuid())
  momentId  String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([momentId, createdAt])
  @@index([authorId, createdAt])
}

/// Souvenir partagé après un Moment vécu (photo, vidéo ou mot), par l'hôte ou un participant.
model Souvenir {
  id        String    @id @default(cuid())
  momentId  String
  authorId  String
  body      String    @default("")
  mediaType MediaType @default(TEXT)
  mediaUrl  String?
  posterUrl String?
  createdAt DateTime  @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([momentId, createdAt])
}

/// Note privée laissée après un Moment vécu, par une personne présente, sur une autre personne présente.
/// Notes de 1 à 5. Seules les moyennes (à partir d'un minimum d'avis) sont montrées ou utilisées.
model Rating {
  id           String   @id @default(cuid())
  momentId     String
  raterId      String
  rateeId      String
  /// La personne notée était l'hôte du Moment.
  rateeIsHost  Boolean  @default(false)
  punctuality  Int
  ambiance     Int
  respect      Int
  /// Hôte uniquement : organisation et fidélité à la description.
  organisation Int?
  accuracy     Int?
  /// Commentaire privé, lu par la modération seulement.
  comment      String   @default("")
  /// La personne signale ne pas être venue (no-show).
  noShow       Boolean  @default(false)
  /// Note générale en étoiles (1 à 5). null pour les anciens avis notés critère par critère.
  stars        Int?
  /// Qualités et remarques choisies en un geste (ex. « sympa », « ponctuel », « retard »).
  tags         String[] @default([])
  /// « Tu referais un Moment avec elle/lui ? »
  again        Boolean?
  createdAt    DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  rater  User   @relation("RatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  ratee  User   @relation("RatingRatee", fields: [rateeId], references: [id], onDelete: Cascade)

  @@unique([momentId, raterId, rateeId])
  @@index([rateeId])
}
