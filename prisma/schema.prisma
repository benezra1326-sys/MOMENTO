// Momento — modèle de données du MVP.
// Voir docs/ARCHITECTURE.md pour les règles métier (capacité, visibilité, blocage).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MomentStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

/// public      : visible dans le feed, place confirmée immédiatement (accès instantané choisi par l'hôte)
/// request     : visible dans le feed, l'hôte accepte ou refuse chaque demande
/// invite_only : absent du feed, visible par l'hôte et les personnes invitées
/// private     : absent du feed, visible par lien direct, l'hôte accepte ou refuse
enum MomentVisibility {
  PUBLIC
  REQUEST
  INVITE_ONLY
  PRIVATE
}

enum MediaType {
  IMAGE
  VIDEO
  TEXT
}

enum MembershipKind {
  REQUEST // l'utilisateur demande à rejoindre
  INVITE  // l'hôte invite l'utilisateur
}

enum MembershipStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum NotificationType {
  JOIN_REQUEST
  REQUEST_ACCEPTED
  REQUEST_DECLINED
  INVITATION
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  MEMBER_LEFT
  MOMENT_CANCELLED
  MOMENT_UPDATED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  /// Identifiant Google (claim « sub ») si le compte utilise la connexion Google.
  googleId     String?       @unique
  /// Identifiant Facebook (propre à l'app Momento) si le compte utilise la connexion Facebook.
  facebookId   String?       @unique
  /// Date de confirmation de l'adresse e-mail (lien reçu par e-mail, ou e-mail vérifié par Google).
  emailVerifiedAt DateTime?
  name         String
  username     String        @unique
  bio          String        @default("")
  photoUrl     String?
  city         String        @default("")
  interests    String[]      @default([])
  role         UserRole      @default(USER)
  status       AccountStatus @default(ACTIVE)
  /// Compte de démonstration : fictif, jamais présenté comme réel.
  isDemo       Boolean       @default(false)
  /// L'utilisateur choisit si ses Moments vécus apparaissent sur son profil public.
  showPastMoments Boolean    @default(true)
  /// Lecture automatique (muette) des vidéos du feed.
  autoplayVideos  Boolean    @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions      Session[]
  hostedMoments Moment[]           @relation("MomentHost")
  memberships   MomentMembership[] @relation("MembershipUser")
  initiated     MomentMembership[] @relation("MembershipInitiator")
  notifications Notification[]
  reportsFiled  Report[]           @relation("ReportReporter")
  blocksMade    Block[]            @relation("Blocker")
  blocksGot     Block[]            @relation("Blocked")
  authTokens    AuthToken[]
  uploads       Upload[]
}

model Session {
  id        String   @id // sha256 du jeton ; le jeton brut ne vit que dans le cookie
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Moment {
  id          String           @id @default(cuid())
  hostId      String
  title       String
  description String
  category    String
  vibeTags    String[]         @default([])
  mediaType   MediaType        @default(IMAGE)
  mediaUrl    String?
  posterUrl   String?
  /// Couleur/dégradé de la carte texte (clé de thème).
  textTheme   String?
  city        String
  /// Zone large visible par tous (quartier, plage…).
  area        String           @default("")
  /// Nom du lieu, visible par tous (peut être générique : « Rooftop à Golden Mile »).
  placeName   String           @default("")
  /// Adresse exacte : visible par l'hôte et les participants acceptés si addressMembersOnly.
  address     String?
  addressMembersOnly Boolean   @default(true)
  startsAt    DateTime
  endsAt      DateTime?
  timezone    String           @default("Europe/Madrid")
  /// Places pour les invités (hôte non compris).
  capacity    Int
  status      MomentStatus     @default(DRAFT)
  visibility  MomentVisibility @default(REQUEST)
  showAttendees Boolean        @default(true)
  isDemo      Boolean          @default(false)
  cancelReason String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  publishedAt DateTime?
  cancelledAt DateTime?

  host        User               @relation("MomentHost", fields: [hostId], references: [id], onDelete: Cascade)
  memberships MomentMembership[]
  reports     Report[]

  @@index([status, visibility, startsAt])
  @@index([city, startsAt])
  @@index([category, startsAt])
  @@index([hostId, startsAt])
}

model MomentMembership {
  id          String           @id @default(cuid())
  momentId    String
  userId      String
  initiatorId String
  kind        MembershipKind
  status      MembershipStatus @default(PENDING)
  message     String?
  /// Le participant accepte d'apparaître dans la liste visible des participants.
  showOnMoment Boolean         @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  respondedAt DateTime?

  moment    Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User   @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  initiator User   @relation("MembershipInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)

  /// Une seule ligne par personne et par Moment : pas de doublon de demande/invitation.
  @@unique([momentId, userId])
  @@index([momentId, status])
  @@index([userId, status])
  @@index([initiatorId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  momentId  String?
  actorId   String?
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetUserId String?
  momentId   String?
  reason     String
  details    String       @default("")
  status     ReportStatus @default(OPEN)
  resolvedById String?
  resolution String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  reporter User    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moment   Moment? @relation(fields: [momentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// Journal des actions d'administration (suspension, retrait de contenu).
model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetType String
  targetId  String
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([targetType, targetId])
}

enum AuthTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Jeton à usage unique envoyé par e-mail. Seul son hachage sha256 est stocké.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

/// Fichier envoyé par un utilisateur : sert aux quotas et au nettoyage des fichiers.
model Upload {
  id        String   @id @default(cuid())
  userId    String
  url       String
  purpose   String
  bytes     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
