# Upclose : variables d'environnement. Copie ce fichier en .env et remplis.
# Ne commit jamais de vraies valeurs.

# Base PostgreSQL. En production : chaîne "pooler" Supabase (port 6543) avec ?pgbouncer=true&sslmode=require.
# Si TLS échoue ("self-signed certificate"), lance `npm run db:check` : ne désactive pas la vérification.
DATABASE_URL="postgresql://postgres@localhost:5432/upclose"

# Mode démo : connexion en un clic aux comptes fictifs, bandeau "démo" visible.
# En production il reste désactivé sauf si ALLOW_DEMO_IN_PRODUCTION=true.
DEMO_MODE=true
ALLOW_DEMO_IN_PRODUCTION=false

# URL publique de l'app (sert à l'URL de retour Google). Ex. https://upclose.world
APP_URL=https://upclose.world

# Connexion Google (OAuth "Application Web"). Laisse vide pour masquer le bouton.
# URI de redirection autorisée à déclarer chez Google : ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ville pilote et fuseau par défaut
PILOT_CITY=Marbella
DEFAULT_TIMEZONE=Europe/Madrid

# Stockage des médias (voir docs/MEDIA.md).
# En production : Vercel Blob. Le jeton est posé automatiquement quand le store est relié au projet Vercel.
BLOB_READ_WRITE_TOKEN=
# Optionnel : force "blob", "local" (dev uniquement) ou "none". Sans valeur : blob si le jeton existe,
# sinon "local" en dev et "none" en production (l'envoi est alors refusé proprement).
STORAGE_DRIVER=

# E-mails transactionnels (vérification d'adresse, mot de passe oublié). Un seul fournisseur suffit.
# Sans fournisseur : en dev le lien s'affiche dans la console du serveur ; en production rien n'est envoyé.
RESEND_API_KEY=
BREVO_API_KEY=
# Expéditeur. Avec Resend sans domaine vérifié, seul "onboarding@resend.dev" marche, et uniquement vers ta propre adresse.
EMAIL_FROM="Upclose <onboarding@resend.dev>"
# Exiger une adresse confirmée pour créer, rejoindre ou inviter. À activer seulement quand les e-mails
# partent vraiment vers tout le monde (domaine vérifié chez le fournisseur). Les comptes démo sont exemptés.
REQUIRE_EMAIL_VERIFICATION=false

# Fonctions en attente de décision produit (true pour activer)
FEATURE_AVAILABILITY=false
FEATURE_POSTS=false
FEATURE_MESSAGING=false
FEATURE_QR=false

# Garde-fou : autorise `npm run db:seed` contre une base de production (données démo uniquement)
SEED_ALLOW_PRODUCTION=false
